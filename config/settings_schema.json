  {
    "name": "Scrollbar Settings",
    "settings": [
      {
        "type": "color",
        "id": "thumb_color",
        "label": "Scrollbar Color",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "track_color",
        "label": "Scrollbar Background Color",
        "default": "#FFF"
      },
      {
        "type": "range",
        "id": "thumb_radius",
        "min": 0,
        "max": 5,
        "step": 1,
        "unit": "px",
        "label": "Scrollbar Radius",
        "default": 0
      },
      {
        "type": "paragraph",
        "content": "Note: Scrollbar Distance only affects scrollbar on shop page"
      },
      {
        "type": "range",
        "id": "scrollbar-distance",
        "min": 10,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Scrollbar Distance",
        "default": 10
      }
    ]
  },
  {
    "name": "Shop Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "enter_screen_logo",
        "label": "Enter Screen Logo",
        "info": "This will show on the enter screen"
      },
      {
        "type": "range",
        "id": "enter_screen_logo_size",
        "label": "Logo Size (px)",
        "min": 65,
        "max": 165,
        "step": 1,
        "default": 115
      },
      {
        "type": "image_picker",
        "id": "shop_screen_logo",
        "label": "Shop Logo",
        "info": "This will show on all other pages except enter screen"
      },
      {
        "type": "range",
        "id": "shop_screen_logo_size",
        "label": "Logo Size (px)",
        "min": 65,
        "max": 165,
        "step": 1,
        "default": 115
      },
      {
        "type": "image_picker",
        "id": "mobile_logo",
        "label": "Mobile logo",
        "info": "Shown on screens 767px wide and below. Leave blank to use the IYH monogram."
      },
      {
        "type": "range",
        "id": "mobile_logo_size",
        "label": "Mobile logo width",
        "min": 24,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 44
      }
    ]
  },
  {
    "name": "Shop Layout",
    "settings": [
      {
        "type": "select",
        "id": "desktop-layout",
        "label": "Desktop Columns",
        "options": [
          {
            "value": "1fr 1fr",
            "label": "Two"
          },
          {
            "value": "1fr 1fr 1fr",
            "label": "Three"
          },
          {
            "value": "1fr 1fr 1fr 1fr",
            "label": "Four"
          }
        ],
        "default": "1fr 1fr 1fr"
      },
      {
        "type": "select",
        "id": "mobile-layout",
        "label": "Mobile Columns",
        "options": [
          {
            "value": "1fr",
            "label": "One"
          },
          {
            "value": "1fr 1fr",
            "label": "Two"
          }
        ],
        "default": "1fr 1fr"
      },
      {
        "type": "range",
        "id": "column-gap-desktop",
        "label": "Column Gap (Desktop)",
        "min": 0,
        "max": 24,
        "unit": "px",
        "step": 1,
        "default": 16
      },
      {
        "type": "range",
        "id": "row-gap-desktop",
        "label": "Row Gap (Desktop)",
        "min": 0,
        "max": 24,
        "unit": "px",
        "step": 1,
        "default": 16
      },
      {
        "type": "range",
        "id": "row-gap-mobile",
        "label": "Row Gap (Mobile)",
        "min": 0,
        "max": 24,
        "unit": "px",
        "step": 1,
        "default": 16
      },
      {
        "type": "range",
        "id": "column-gap-mobile",
        "label": "Column Gap (Mobile)",
        "min": 0,
        "max": 24,
        "unit": "px",
        "step": 1,
        "default": 16
      },
      {
        "type": "range",
        "id": "product-size",
        "label": "Product Image Size",
        "min": 60,
        "max": 100,
        "unit": "%",
        "step": 1,
        "default": 100
      }
    ]
  },
  {
    "name": "Seo Settings",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon Image",
        "info": "Will be scaled down to 32x32px"
      },
      {
        "type": "image_picker",
        "id": "apple_touch_icon",
        "label": "Apple touch icon image",
        "info": "Will be scaled down to 120x120px"
      },
      {
        "type": "checkbox",
        "id": "enable_product_rich_snippets",
        "label": "Enable Product Rich Snippets",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_article_rich_snippets",
        "label": "Enable Article Rich Snippets",
        "default": true
      }
    ]
  }

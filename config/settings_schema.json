[
  {
    "name": "theme_info",
    "theme_name": "Plain Jane",
    "theme_author": "OPENSPACES",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://openspaces.design",
    "theme_support_email": "info@openspaces.design"
  },
  {
    "name": "Announcement Bar",
    "settings": [
      {
        "type": "color",
        "id": "announcement_background_color",
        "label": "Announcement Bar Color",
        "default": "#000000"
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Announcement Text",
        "default": "Insert Announcement Text Here. Change me or turn me off in theme settings."
      },
      {
        "type": "color",
        "id": "announement-text-color",
        "label": "Announcement Text Color",
        "default": "#FFF"
      },
      {
        "type": "checkbox",
        "id": "show_announcement_bar",
        "label": "Show Announcement Bar",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "hide_announcemenet_bar_on_home",
        "label": "Show Announcement Bar On Home Page",
        "default": false
      }
    ]
  },
  {
    "name": "Music Player",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_music",
        "label": "Show Music Player",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "music_img",
        "label": "Disk Cover Image"
      },
      {
        "type": "checkbox",
        "id": "show_disk",
        "label": "Show Disk",
        "default": true
      },
      {
        "type": "header",
        "content": "Upload Music"
      },
      {
        "type": "paragraph",
        "content": "To upload music follow these steps:"
      },
      {
        "type": "paragraph",
        "content": "Go back to the Shopify Admin Panel > Click \"Content\" > Files > Upload A File(Make sure its .mp3) > Copy the link and paste below"
      },
      {
        "type": "text",
        "id": "music_url",
        "label": "Music URL"
      },
      {
        "type": "color",
        "id": "music_btn_color",
        "label": "Music Player Button Color",
        "default": "#cdc2d0"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Paragraph Font",
        "default": "inconsolata_n4"
      },
      {
        "type": "font_picker",
        "id": "font_header",
        "label": "Header Fonts",
        "default": "inconsolata_n4"
      },
      {
        "type": "font_picker",
        "id": "btn_font",
        "label": "Button Fonts",
        "default": "inconsolata_n4"
      }
    ]
  },

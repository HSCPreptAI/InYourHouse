/*
  IN YOUR HOUSE — brand layer for the Supreme theme.
  Loaded after the theme CSS. Type system carried over from the current site:
  Neue Haas Display Medium: headings, nav, buttons, prices
  Neue Haas Grotesk Text Roman: reading text, plus small caps labels
*/
@font-face {
  font-family: "Neue Haas Display";
  src: url("{{ 'NeueHaasDisplay-Mediu.woff2' | asset_url }}") format("woff2");
  font-weight: 500;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Neue Haas Text";
  src: url("{{ 'NHaasGroteskTXPro-55Rg.otf' | asset_url }}") format("opentype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

:root {
  --iyh-ink: #181818;
  --iyh-logo-ink: #2f2b2c;
  --iyh-paper: #ffffff;
  --iyh-concrete: #e8e8e8;
  --iyh-cream: #f8f3eb;
  --iyh-body-font: "Neue Haas Text", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --iyh-heading-font: "Neue Haas Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

/* Reading text */
body, p, .paragraph, .rich-text-block, .w-richtext, .contact-content,
input, textarea, select, .product-description, .text-block-9, .text-block-18 {
  font-family: var(--iyh-body-font);
  font-weight: 400;
}

/* Headings and shopping controls */
/* Buttons, nav and prices share the heading tracking */
h1, h2, h3, h4, h5, h6, .heading-4,
.product-title, .prouduct-title, .nav-link, .nav-link.shop, .menu-link, .btn, .w-button,
.add_btn_font, .add_header_font, .checkout-button-2, .text-block-16,
.w-commerce-commercecartheading, .w-commerce-commercecheckoutplaceorderbutton,
.w-commerce-commerceaddtocartbutton, .add-to-cart-button, input[type="submit"] {
  font-family: var(--iyh-heading-font);
  font-weight: 500;
  font-synthesis: none;
  letter-spacing: -0.015em;
}

/* Labels: clock, credits, announcement bar (.text-block) */
.date, .time, .time.invert, .credits, .text-block, .iyh-label {
  font-family: var(--iyh-body-font);
  font-weight: 400;
  font-size: 11px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

/* Logo sizing: IYH monogram on desktop, wordmark on mobile */
.logo { width: var(--iyh-logo-w, 165px); height: auto; max-width: 100%; }
@media (max-width: 479px) {
  .logo { width: var(--iyh-logo-w-mobile, var(--iyh-logo-w, 140px)); max-width: 70vw; }
}

::selection { background: var(--iyh-ink); color: var(--iyh-paper); }

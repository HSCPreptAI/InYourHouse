{%- comment -%}
  IYH logo: in your house! wordmark on desktop, IYH monogram on mobile (767px and below).
  Usage: {% render 'iyh-logo', kind: 'enter' %} on the homepage, 'shop' everywhere else.
{%- endcomment -%}
{%- liquid
  if kind == 'enter'
    assign logo = settings.enter_screen_logo
    assign logo_size = settings.enter_screen_logo_size
  else
    assign logo = settings.shop_screen_logo
    assign logo_size = settings.shop_screen_logo_size
  endif
  assign mobile_logo = settings.mobile_logo
  assign mobile_size = settings.mobile_logo_size | default: logo_size
-%}
<picture>
  {%- if mobile_logo != blank -%}
    <source media="(max-width: 767px)" srcset="{{ mobile_logo | image_url: width: 300 }}">
  {%- else -%}
    <source media="(max-width: 767px)" srcset="{{ 'iyh-monogram-black.png' | asset_url }}">
  {%- endif -%}
  <img
    src="{% if logo != blank %}{{ logo | image_url: width: 1200 }}{% else %}{{ 'Supreme-dummy.png' | asset_url }}{% endif %}"
    alt="{{ shop.name | escape }}"
    class="logo"
    style="--iyh-logo-w: {{ logo_size }}px; --iyh-logo-w-mobile: {{ mobile_size }}px;"
  >
</picture>

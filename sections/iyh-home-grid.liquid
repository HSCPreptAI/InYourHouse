{%- comment -%}
  IYH product grid: large images on white, title and price underneath.
{%- endcomment -%}
{%- assign grid_collection = section.settings.collection -%}
{%- if grid_collection == blank -%}{%- assign grid_collection = collections.all -%}{%- endif -%}
<section class="iyh-grid">
  <div class="iyh-grid__head">
    <h2 class="iyh-grid__title">{{ section.settings.heading | default: grid_collection.title }}</h2>
    <a class="iyh-label" href="{{ grid_collection.url }}">View all</a>
  </div>
  <ul class="iyh-grid__list" role="list">
    {%- for item in grid_collection.products limit: section.settings.limit -%}
      <li class="iyh-card">
        <a href="{{ item.url }}" class="iyh-card__link">
          <div class="iyh-card__media">
            {%- if item.featured_image != blank -%}
              <img src="{{ item.featured_image | image_url: width: 1200 }}" alt="{{ item.featured_image.alt | default: item.title | escape }}" loading="lazy" width="1200" height="1500">
            {%- endif -%}
            {%- if item.images[1] != blank -%}
              <img class="iyh-card__alt" src="{{ item.images[1] | image_url: width: 1200 }}" alt="" loading="lazy" width="1200" height="1500">
            {%- endif -%}
            {%- if item.tags contains 'PRE-ORDER' -%}
              <span class="iyh-card__badge iyh-label">Pre-order</span>
            {%- elsif item.available == false -%}
              <span class="iyh-card__badge iyh-label">Sold out</span>
            {%- endif -%}
          </div>
          <div class="iyh-card__meta">
            <span class="iyh-card__title">{{ item.title }}</span>
            <span class="iyh-card__price">{{ item.price | money }}</span>
          </div>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "IYH product grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "ISSUE 001" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 }
  ]
}
{% endschema %}
